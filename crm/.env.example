# Copia a .env y llena. NUNCA subas .env a git.
RESEND_API_KEY=
RESEND_FROM=info@mail.acitmx.net
GOOGLE_PLACES_API_KEY=
# Tope mensual de Places (límite gratuito Pro 5000 - 100)
PLACES_MONTHLY_CAP=4900
# Ruta a obscura.exe
OBSCURA_BIN=../tools/obscura/obscura.exe
# Puerto del CRM (solo 127.0.0.1)
CRM_PORT=4010
# Base de datos SQLite
CRM_DB_PATH=./data/crm.db

# --- Fuentes de descubrimiento gratuitas (P11). Guía paso a paso: ..\PASOS-MANUALES-FUENTES.md ---
# Token GRATUITO de la API del DENUE (INEGI). Vacío = la fuente «DENUE (API)» queda sin usar;
# el DENUE local (CSV descargado) NO necesita token. Nunca subas el token a git.
# Solicítalo en: https://www.inegi.org.mx/app/api/denue/tokenVerify/tokenverify.html
DENUE_TOKEN=
# Opcional: otra instancia de Overpass (por defecto la pública overpass-api.de, con límites de uso justo).
# OVERPASS_URL=https://overpass-api.de/api/interpreter
