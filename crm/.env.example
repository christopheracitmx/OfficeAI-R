# Copia este archivo a .env (en la carpeta crm) y llénalo. NUNCA subas .env a git.
# Todas las variables son opcionales: el CRM arranca aunque estén vacías y avisa qué falta.
# Guía completa de cada variable: ..\GUIA-INSTALACION.md (sección «Configura crm\.env»).

# --- Correo de alertas (Resend: https://resend.com/api-keys) ---
# Sin llave, los correos fallan de forma controlada (los prospectos se guardan igual).
RESEND_API_KEY=
# Remitente. Vacío = onboarding@resend.dev (solo de pruebas: Resend solo entrega al correo dueño de tu cuenta).
# Para enviar a otras personas verifica un dominio propio en https://resend.com/domains y usa algo como alertas@tudominio.com
RESEND_FROM=
# Correo del primer destinatario de reportes. Solo se usa la PRIMERA vez que se crea la base (si no hay destinatarios).
# Vacío = no se siembra ninguno; agrégalos luego en Configuración → Correos de reportes.
CRM_DESTINATARIO_INICIAL=

# --- Descubrimiento de empresas (oficina de Prospección) ---
# Google Places (opcional, puede generar costo: ver la guía). Vacío = solo búsqueda web y fuentes gratuitas.
# El tope mensual se ajusta en la app (Configuración → Cuotas y motor), no aquí.
GOOGLE_PLACES_API_KEY=
# Token GRATUITO de la API del DENUE (INEGI). Vacío = la fuente «DENUE (API)» queda sin usar;
# el DENUE local (CSV descargado) NO necesita token. Nunca subas el token a git.
# Solicítalo en: https://www.inegi.org.mx/app/api/denue/tokenVerify/tokenverify.html
DENUE_TOKEN=
# Opcional: otra instancia de Overpass (por defecto la pública overpass-api.de, con límites de uso justo).
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Lectura web ---
# Ruta a obscura.exe (relativa a la carpeta crm, o absoluta). Vacío = ../tools/obscura/obscura.exe
# Si el archivo no existe, el CRM arranca y muestra un aviso; los agentes leen la web solo con web_search.
OBSCURA_BIN=../tools/obscura/obscura.exe

# --- Servidor ---
# Puerto del CRM (solo 127.0.0.1)
CRM_PORT=4010
# Base de datos SQLite (relativa a la carpeta crm)
CRM_DB_PATH=./data/crm.db
